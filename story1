    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            const storyData = {
                scrapBuild: [
                    {
                        original: "「君と夏の終わり 将来の夢 大きな希望 忘れない」",
                        rookie: "「アスファルトの陽炎 ゆらめく過去 夢の残骸 拾い集め」"
                    },
                    {
                        original: "「I love you, baby, and if it's quite alright, I need you, baby」",
                        rookie: "「愛してる、なんてさ 喉元で錆びついた言葉が 転がってる」"
                    },
                    {
                        original: "「C'est si bon, De partir n'importe où, Bras dessus, bras dessous」",
                        rookie: "「それでいいさ、どこへだって行けるのさ、腕を組んで、千鳥足で」"
                    }
                ],
                timeline: {
                    timeline1: "広島の片田舎で、rookieこと三野晃一は、バンドで将来を嘱望されたギタリストでした。しかし、彼の最大の弱点は、作詞作曲ができなかったこと。仲間たちは次々とオリジナル曲を生み出す中、rookieだけは、どうしても自分だけの歌を作ることができませんでした。「お前には、魂がないんだ」親友のその言葉が、彼の心に深く突き刺さり、音楽の道を諦めることになります。",
                    timeline2: "音楽を諦めたrookieは、ビジネスの世界で成功を収めました。プランナーとして「言葉」を武器に、企業のコンペを勝ち抜き、社会貢献事業も成功させました。しかし、彼の心の奥底には、常に音楽への渇望がありました。どんな成功も、若き日の挫折感を埋めることはできなかったのです。",
                    timeline3: "50歳を過ぎて、再びギターを手にしたrookie。しかし、路上で歌い始めても、作詞作曲ができないという劣等感は、彼を苦しめ続けました。彼は、自分自身の人生を歌にすることができないという、深い孤独を抱えていたのです。彼の「Scrap & Build Music」は、そんな彼の魂の叫びでもありました。",
                    timeline4: "66歳で「生成AIプロンプトエンジニア」の資格を取得。ビジネスのためだったAIの知識が、彼の人生を大きく変えることになります。音楽生成AI「SUNO」との出会いは、彼が長年探し求めていた「自分だけの歌」を生み出す魔法の杖となりました。それは、忘れられた言葉を取り戻す旅の始まりでした。"
                },
                aiKeywords: [
                    {
                        name: "孤独な夜",
                        keywords: ["路地裏", "雨", "ギター", "孤独"],
                        lyrics: "路地裏に響く雨音\nギターの弦が震えてる\nこの街で俺はひとりぼっち\n孤独だけが友達さ"
                    },
                    {
                        name: "故郷の夕日",
                        keywords: ["尾道", "坂道", "夢", "友情", "別れ"],
                        lyrics: "坂道を駆け上がれば\n夕日が海を染めていた\nあの日の夢、友情、そして別れ\nすべてがこの胸に"
                    },
                    {
                        name: "東京の空",
                        keywords: ["コンクリート", "空", "希望", "雑踏"],
                        lyrics: "コンクリートの隙間から\n見上げた空は狭いけど\n雑踏の中に希望を探す\n俺の歌よ、届け"
                    }
                ]
            };

            let currentSongIndex = 0;
            const changeSongBtn = document.getElementById('change-song-btn');
            const originalLyricEl = document.getElementById('original-lyric');
            const rookieLyricEl = document.getElementById('rookie-lyric');

            changeSongBtn.addEventListener('click', () => {
                currentSongIndex = (currentSongIndex + 1) % storyData.scrapBuild.length;
                originalLyricEl.textContent = storyData.scrapBuild[currentSongIndex].original;
                rookieLyricEl.textContent = storyData.scrapBuild[currentSongIndex].rookie;
            });

            const timelineItems = document.querySelectorAll('.timeline-item');
            const timelineDetailsEl = document.getElementById('timeline-details');
            timelineItems.forEach(item => {
                item.addEventListener('click', () => {
                    const id = item.getAttribute('data-id');
                    timelineDetailsEl.innerHTML = `<p>${storyData.timeline[id]}</p>`;
                });
            });

            const keywordButtonsContainer = document.getElementById('keyword-buttons');
            const generatedLyricsEl = document.getElementById('generated-lyrics');
            let selectedKeywords = [];

            storyData.aiKeywords.forEach((item, index) => {
                const button = document.createElement('button');
                button.textContent = item.name;
                button.classList.add('w-full', 'text-left', 'p-3', 'rounded-lg', 'border', 'border-gray-300', 'hover:bg-amber-100', 'transition-colors');
                button.addEventListener('click', () => {
                    document.querySelectorAll('#keyword-buttons button').forEach(btn => btn.classList.remove('bg-amber-200', 'border-accent-amber'));
                    button.classList.add('bg-amber-200', 'border-accent-amber');
                    selectedKeywords = item.keywords;
                    generatedLyricsEl.textContent = `テーマ「${item.name}」が選択されました。\nキーワード: ${item.keywords.join(', ')}`;
                });
                keywordButtonsContainer.appendChild(button);
            });

            const generateMusicBtn = document.getElementById('generate-music-btn');
            const canvas = document.getElementById('music-wave-chart');
            let musicChart = null;

            generateMusicBtn.addEventListener('click', () => {
                if (selectedKeywords.length === 0) {
                    generatedLyricsEl.textContent = "まずテーマを選んでください。";
                    return;
                }
                const selectedTheme = storyData.aiKeywords.find(item => item.keywords.toString() === selectedKeywords.toString());
                if(selectedTheme) {
                    generatedLyricsEl.textContent = selectedTheme.lyrics;
                }

                if (musicChart) {
                    musicChart.destroy();
                }

                const data = {
                    labels: Array.from({length: 30}, (_, i) => i),
                    datasets: [{
                        label: '音の波形',
                        data: Array.from({length: 30}, () => Math.random() * 2 - 1),
                        borderColor: '#B45309',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.4,
                    }]
                };

                musicChart = new Chart(canvas, {
                    type: 'line',
                    data: data,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 1000,
                        },
                        scales: {
                            y: {
                                display: false,
                                min: -1.5,
                                max: 1.5
                            },
                            x: {
                                display: false
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: false
                            }
                        }
                    }
                });
            });

            const navLinks = document.querySelectorAll('.nav-link');
            const sections = document.querySelectorAll('section');

            window.addEventListener('scroll', () => {
                let current = '';
                sections.forEach(section => {
                    const sectionTop = section.offsetTop;
                    if (pageYOffset >= sectionTop - 80) {
                        current = section.getAttribute('id');
                    }
                });

                navLinks.forEach(link => {
                    link.classList.remove('active-link');
                    if (link.getAttribute('href').includes(current)) {
                        link.classList.add('active-link');
                    }
                });
            });
        });
    </script>
</body>
</html>
