    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <section id="prologue" class="py-16 text-center">
            <h2 class="text-4xl font-bold text-warm-brown mb-4">序章：東京砂漠の片隅で</h2>
